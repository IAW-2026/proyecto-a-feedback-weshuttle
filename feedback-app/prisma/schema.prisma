generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id

  role Role @default(PASSENGER)
  reviewsSent     Review[] @relation("ReviewsSent")
  reviewsReceived Review[] @relation("ReviewsReceived")
  createdAt DateTime @default(now())
}

model Review {
  id String @id @default(cuid())
  pool_id String
  reservation_id String? // Nuevo campo: Identificador externo de la reserva asociada.

  author_user_id String // Renombrado de autor_id
  author_role    String // Nuevo campo: Rol del autor
  target_user_id String // Renombrado de destinatario_id
  target_role    String // Nuevo campo: Rol del usuario calificado

  author    User @relation("ReviewsSent", fields: [author_user_id], references: [id])
  recipient User @relation("ReviewsReceived", fields: [target_user_id], references: [id])

  rating  Int?    // Renombrado de calificacion
  comment String? // Renombrado de comentario

  status ReviewStatus @default(PRECREATED) // Renombrado de estado_reseña

  enabled_at  DateTime? // Nuevo campo: Fecha en la que la reseña pasó a estar visible.
  completed_at DateTime? // Nuevo campo: Fecha en la que el usuario completó la reseña.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RatingAverage {
  id             String   @id @default(cuid())
  user_id        String
  role           String   // rider, driver
  average_rating Float?
  total_reviews  Int      @default(0)
  updated_at     DateTime @updatedAt

  @@unique([user_id, role])
}

model Report {
  id               String    @id @default(cuid())
  pool_id          String?
  reservation_id   String?
  reporter_user_id String
  reporter_role    String
  reported_user_id String
  reported_role    String
  reason           String
  description      String?
  status           String    @default("PENDING") // PENDING, REVIEWED, REJECTED
  reviewed_at      DateTime?
  createdAt        DateTime  @default(now())
}

enum ReviewStatus { // Renombrado de EstadoReseña
  PRECREATED
  PENDING
  COMPLETED
}

enum Role {
  PASSENGER
  DRIVER
  ADMIN
}