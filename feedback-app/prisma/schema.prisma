generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id

  role Role @default(PASSENGER)

  reviewsSent Review[] @relation("ReviewsSent")

  reviewsReceived Review[] @relation("ReviewsReceived")

  createdAt DateTime @default(now())
}

model Review {
  id String @id @default(cuid())

  pool_id String

  autor_id String
  destinatario_id String

  author User @relation("ReviewsSent", fields: [autor_id], references: [id])

  recipient User @relation("ReviewsReceived", fields: [destinatario_id], references: [id])

  calificacion Int?
  comentario String?

  estado_reseña EstadoReseña @default(PRECREATED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EstadoReseña {
  PRECREATED
  PENDING
  COMPLETED
}

enum Role {
  PASSENGER
  DRIVER
  ADMIN
}