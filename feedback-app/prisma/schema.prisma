generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Review {
  id                  String         @id @default(cuid())

  pool_id             String

  autor_id            String
  destinatario_id     String

  calificacion        Int?
  comentario          String?

  estado_reseña       EstadoReseña  @default(PENDING)

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

enum EstadoReseña {
  PENDING
  COMPLETED
}
